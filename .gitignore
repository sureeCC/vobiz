# Local .terraform directories (anywhere in nested folders)
**/.terraform/*
**/.terraform/

# .tfstate files
*.tfstate
*.tfstate.*
**/*.tfstate
**/*.tfstate.*

# Crash log files
crash.log
crash.*.log
**/crash.log
**/crash.*.log

# Exclude all .tfvars files (sensitive data, passwords, keys)
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
**/*.tfvars
**/*.tfvars.json
**/*.auto.tfvars
**/*.auto.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
**/override.tf
**/override.tf.json
**/*_override.tf
**/*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc