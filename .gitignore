# Local .terraform directories (anywhere in nested folders)
**/.terraform/*
**/.terraform/

# .tfstate files
*.tfstate
*.tfstate.*
**/*.tfstate
**/*.tfstate.*
**/.terraform.lock.hcl

# Crash log files
crash.log
crash.*.log
**/crash.log
**/crash.*.log

# Exclude all .tfvars files
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
**/*.tfvars
**/*.tfvars.json
**/*.auto.tfvars
**/*.auto.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
**/override.tf
**/override.tf.json
**/*_override.tf
**/*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc
# New independent deployment roots commit provider locks.
!workloads/prod/cache/.terraform.lock.hcl
!workloads/prod/registry/.terraform.lock.hcl
!workloads/prod/secrets/.terraform.lock.hcl
!workloads/prod/identity/.terraform.lock.hcl
!workloads/prod/argocd/.terraform.lock.hcl
**/backend.hcl
*.tfplan
gha-creds-*.json

# Local validation and deployment artifacts
__pycache__/
*.pyc
plan-manifest.json
plan.txt
plan.json
