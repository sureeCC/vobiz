# This layer is optional and creates nothing with these mock values.
enable_http_load_balancer = false
http_load_balancer_name   = "vobiz-prod-https"
http_address_name         = "vobiz-prod-https-ip"
armor_policy_name         = "vobiz-prod-http-policy"
http_domains              = ["api.example.com"]
http_backends             = {}
voice_address_names       = []
dns_zones                 = {}
