#   api = {
#     service_account_id = "projects/PROJECT_ID/serviceAccounts/vobiz-prod-api@PROJECT_ID.iam.gserviceaccount.com"
#     namespace = "vobiz"
#     kubernetes_service_account = "api"
#   }
# }
