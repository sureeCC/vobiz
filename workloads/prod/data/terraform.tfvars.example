# LATER PHASE: all managed data targets are disabled by default.
enable_sql                  = false
enable_cache                = false
network_name                = "vobiz-prod-vpc"
private_services_range_name = "vobiz-prod-private-services"
sql = {
  name              = "vobiz-prod-postgresql"
  database_version  = "POSTGRES_15"
  tier              = "db-custom-2-8192"
  replica_tier      = "db-custom-2-8192"
  replica_zone      = "asia-south1-b"
  disk_size_gb      = 100
  backup_start_time = "20:00"
  retained_backups  = 7
}
cache = { name = "vobiz-prod-cache", memory_size_gb = 1, redis_version = "REDIS_7_2" }
buckets = {}
# Example only: use globally unique approved names.
# buckets = { mock-vobiz-recordings-unique = { storage_class = "STANDARD", versioning = true } }
