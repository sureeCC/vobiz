# MOCK VALUES ONLY; approved network allocations are required before deployment.
network_name = "vobiz-prod-vpc"
routing_mode = "REGIONAL"
vnet_description = "Vobiz production network"
subnets = [
  { subnet_name = "vobiz-prod-as1-subnet-gke", subnet_ip = "10.80.0.0/20", subnet_region = "asia-south1", subnet_private_access = "true" },
  { subnet_name = "vobiz-prod-as1-subnet-voice", subnet_ip = "10.80.16.0/24", subnet_region = "asia-south1", subnet_private_access = "true" }
]
secondary_ranges = {
  vobiz-prod-as1-subnet-gke = [
    { range_name = "vobiz-prod-as1-range-pods", ip_cidr_range = "10.84.0.0/16" },
    { range_name = "vobiz-prod-as1-range-services", ip_cidr_range = "10.85.0.0/20" }
  ]
}
routes = []
ingress_rules = []
egress_rules = []
private_service_access_config = { enable_private_services_connection = false, address_name = "vobiz-prod-private-services", prefix_length = 16 }
delete_default_internet_gateway_routes = false
create_router = true
router_name = "vobiz-prod-as1-egress-router"
router_description = "Outbound Cloud NAT router; VPN uses a separate router"
nats = [{
  name = "vobiz-prod-as1-nat"
  nat_ip_allocate_option = "AUTO_ONLY"
  source_subnetwork_ip_ranges_to_nat = "ALL_SUBNETWORKS_ALL_IP_RANGES"
  log_config = { enable = true, filter = "ERRORS_ONLY" }
}]
